{
  "description": "Checks for API key availability on session start",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/check-keys.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
